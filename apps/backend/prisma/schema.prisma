generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  RESPONDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationType {
  GOVERNMENT
  NGO
  PRIVATE_RESCUE
  VETERINARY
  OTHER
}

enum OrganizationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ResponderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceAreaType {
  DISTRICT
  CITY
  STATE
  ZONE
  POLYGON
}

enum DispatchChannel {
  DASHBOARD
  EMAIL
  SMS
  WHATSAPP
  VOICE_CALL
  WEBHOOK
}

enum IncidentType {
  INJURED
  TRAPPED
  DISTRESSED
  DECEASED
  SUSPECTED_DEAD
  ROAD_ACCIDENT
  HUMAN_WILDLIFE_CONFLICT
  SIGHTING
  OTHER
}

enum IncidentStatus {
  DRAFT
  AI_ANALYZED
  AWAITING_RESPONDER_SELECTION
  RESPONDER_SELECTED
  SUBMITTED
  DISPATCHING
  DISPATCHED
  ACKNOWLEDGED
  ACCEPTED
  IN_PROGRESS
  RESOLVED
  FAILED_DISPATCH
  REJECTED
  DUPLICATE
  CANCELLED
}

enum EvidenceType {
  IMAGE
  VIDEO
}

enum AIAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

enum Urgency {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssignmentStatus {
  SELECTED
  DISPATCHING
  DISPATCHED
  ACKNOWLEDGED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum DispatchStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
  SIMULATED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum NotificationType {
  INCIDENT_UPDATE
  DISPATCH_UPDATE
  ORGANIZATION_UPDATE
  SYSTEM
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CLOSED
}

model User {
  id                    String                  @id @default(uuid())
  email                 String                  @unique
  name                  String
  passwordHash          String
  emailVerified         Boolean                 @default(false)
  role                  UserRole                @default(CITIZEN)
  status                UserStatus              @default(ACTIVE)
  phone                 String?
  otpHash               String?
  otpExpiresAt          DateTime?
  refreshTokens         RefreshToken[]
  incidents             Incident[]              @relation("IncidentReporter")
  responder             ResponderProfile?
  reviewedOrganizations Organization[]          @relation("OrganizationReviewer")
  verifications         Verification[]          @relation("VerificationReviewer")
  statusChanges         IncidentStatusHistory[] @relation("StatusChangeActor")
  auditLogs             AuditLog[]              @relation("AuditActor")
  notifications         Notification[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([role, status])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  familyId          String
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Organization {
  id            String                @id @default(uuid())
  name          String
  type          OrganizationType
  status        OrganizationStatus    @default(PENDING)
  description   String?
  contactName   String
  contactEmail  String
  contactPhone  String?
  credentials   String?
  reviewNotes   String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewedBy    User?                 @relation("OrganizationReviewer", fields: [reviewedById], references: [id])
  responders    ResponderProfile[]
  verifications Verification[]
  inquiries     OrganizationInquiry[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, type])
}

model ResponderProfile {
  id                     String                  @id @default(uuid())
  organizationId         String
  userId                 String?                 @unique
  displayName            String
  status                 ResponderStatus         @default(INACTIVE)
  dashboardEnabled       Boolean                 @default(false)
  supportsAllAnimals     Boolean                 @default(true)
  supportedAnimals       String[]                @default([])
  supportedIncidents     IncidentType[]          @default([])
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceAreas           ServiceArea[]
  dispatchConfigurations DispatchConfiguration[]
  selectedForIncidents   Incident[]              @relation("SelectedResponder")
  assignments            IncidentAssignment[]
  dispatchAttempts       DispatchAttempt[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([organizationId, status])
}

model ServiceArea {
  id          String           @id @default(uuid())
  responderId String
  name        String
  type        ServiceAreaType
  district    String?
  state       String?
  city        String?
  zone        String?
  geoJson     Json?
  active      Boolean          @default(true)
  responder   ResponderProfile @relation(fields: [responderId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([district, state])
  @@index([responderId, active])
}

model DispatchConfiguration {
  id          String           @id @default(uuid())
  responderId String
  channel     DispatchChannel
  destination String
  enabled     Boolean          @default(true)
  priority    Int              @default(1)
  metadata    Json?
  responder   ResponderProfile @relation(fields: [responderId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([responderId, channel, destination])
  @@index([responderId, enabled, priority])
}

model Incident {
  id                  String                  @id @default(uuid())
  reporterId          String
  selectedResponderId String?
  publicId            String                  @unique
  animalType          String?
  incidentType        IncidentType
  description         String
  latitude            Decimal                 @db.Decimal(9, 6)
  longitude           Decimal                 @db.Decimal(9, 6)
  locationAccuracy    Float?
  district            String?
  state               String?
  occurredAt          DateTime?
  safetyAcknowledged  Boolean                 @default(false)
  status              IncidentStatus          @default(DRAFT)
  urgency             Urgency                 @default(UNKNOWN)
  submittedAt         DateTime?
  reporter            User                    @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  selectedResponder   ResponderProfile?       @relation("SelectedResponder", fields: [selectedResponderId], references: [id], onDelete: SetNull)
  evidence            Evidence[]
  aiAnalysis          AIAnalysis?
  assignments         IncidentAssignment[]
  dispatchAttempts    DispatchAttempt[]
  statusHistory       IncidentStatusHistory[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([reporterId, createdAt])
  @@index([selectedResponderId, status])
  @@index([district, state, status])
  @@index([status, urgency, createdAt])
}

model Evidence {
  id          String       @id @default(uuid())
  incidentId  String
  type        EvidenceType
  s3Key       String       @unique
  fileName    String
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime?
  incident    Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([incidentId, createdAt])
}

model AIAnalysis {
  id                       String            @id @default(uuid())
  incidentId               String            @unique
  status                   AIAnalysisStatus  @default(PENDING)
  modelId                  String?
  speciesGuess             String?
  incidentAssessment       String?
  recommendedResponderType OrganizationType?
  urgency                  Urgency           @default(UNKNOWN)
  confidence               Float?
  visibleIndicators        String[]          @default([])
  safetyGuidance           String[]          @default([])
  summary                  String?
  rawResponse              Json?
  failureReason            String?
  analyzedAt               DateTime?
  incident                 Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
}

model IncidentAssignment {
  id               String            @id @default(uuid())
  incidentId       String
  responderId      String
  status           AssignmentStatus  @default(SELECTED)
  selectedAt       DateTime          @default(now())
  acknowledgedAt   DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declineReason    String?
  incident         Incident          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responder        ResponderProfile  @relation(fields: [responderId], references: [id], onDelete: Restrict)
  dispatchAttempts DispatchAttempt[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([incidentId, responderId])
  @@index([responderId, status, createdAt])
}

model DispatchAttempt {
  id                String              @id @default(uuid())
  incidentId        String
  responderId       String
  assignmentId      String?
  channel           DispatchChannel
  status            DispatchStatus      @default(QUEUED)
  destination       String
  attemptNumber     Int                 @default(1)
  providerMessageId String?
  providerResponse  Json?
  failureReason     String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  incident          Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  responder         ResponderProfile    @relation(fields: [responderId], references: [id], onDelete: Restrict)
  assignment        IncidentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([incidentId, createdAt])
  @@index([responderId, status, createdAt])
  @@index([assignmentId])
}

model IncidentStatusHistory {
  id         String          @id @default(uuid())
  incidentId String
  actorId    String?
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  note       String?
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor      User?           @relation("StatusChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([incidentId, createdAt])
}

model Verification {
  id             String             @id @default(uuid())
  organizationId String
  reviewerId     String?
  status         VerificationStatus @default(PENDING)
  notes          String?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewer       User?              @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model OrganizationInquiry {
  id               String           @id @default(uuid())
  organizationId   String?
  organizationName String
  organizationType OrganizationType
  contactName      String
  email            String
  phone            String?
  district         String?
  state            String?
  message          String
  status           InquiryStatus    @default(NEW)
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
}
